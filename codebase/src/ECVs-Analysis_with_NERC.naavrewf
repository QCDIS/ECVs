                "name": "conf_ri_matrix_rules",
                "assignation": "conf_ri_matrix_rules = {'exclude': ['instrument'], 'only': {'air_temperature': ['met'], 'air_pressure': ['met'], 'relative_humidity': ['met'], 'wind_speed': ['met'], 'wind_from_direction': ['met'], 'wind_speed_of_gust': ['met'], 'lwe_thickness_of_precipitation_amount': ['met']}}"
