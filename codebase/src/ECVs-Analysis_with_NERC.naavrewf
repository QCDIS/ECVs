            "description": "Step 2 (v2): find the Essential Variable in the NERC Vocabulary Server (EXV) and its CF standard names, ranked: I-ADOPT -> P01 -> P07, P02 -> P07, then the label or object of interest for EXVs NVS has not decomposed.",
            "owner": "user",
            "virtual_lab": "test-virtual-lab-1",
            "container_image": "host.docker.internal:29500/naavre-cells/7ac1b8d7010bb6cd/9a1cef6bb6055b6a/ecvs-nerc-exv-search-v2-user:b90c0b9ea8765df1",
            "base_container_image": {
              "build": "NEW-Registry:5000/naavre-bases/ecvs-cell-build:v1",
              "runtime": "NEW-Registry:5000/naavre-bases/naavre-fl-vanilla-cell-runtime:v0.1.11"
            },
