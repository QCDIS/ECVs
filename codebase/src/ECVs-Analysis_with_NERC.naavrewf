                "assignation": "conf_ri_registry = [{'ri': 'ACTRIS', 'node': 'https://beacon-iriscc.maris.nl', 'table': 'actris-in-situ', 'time': 'time', 'latitude': '.geospatial_lat_min', 'longitude': '.geospatial_lon_min', 'height': '.ebas_station_altitude', 'height_is_text': True, 'site': '.ebas_station_code', 'matrix': '{column}.ebas_matrix', 'screen_all': False, 'token_required': False}, {'ri': 'ACTRIS', 'node': 'https://beacon-iriscc.maris.nl', 'table': 'actris-nrt', 'time': 'time', 'latitude': '.geospatial_lat_min', 'longitude': '.geospatial_lon_min', 'height': '.ebas_station_altitude', 'height_is_text': True, 'site': '.ebas_station_code', 'matrix': '{column}.ebas_matrix', 'screen_all': True, 'token_required': False}, {'ri': 'IAGOS', 'node': 'https://beacon-iriscc.maris.nl', 'table': 'iagos-l2', 'time': 'UTC_time', 'latitude': 'lat', 'longitude': 'lon', 'height': 'baro_alt_AC', 'height_is_text': False, 'site': 'flight_name', 'matrix': None, 'screen_all': True, 'token_required': False}, {'ri': 'IAGOS', 'node': 'https://beacon-iriscc.maris.nl', 'table': 'iagos-l1', 'time': 'UTC_time', 'latitude': 'lat', 'longitude': 'lon', 'height': 'baro_alt_AC', 'height_is_text': False, 'site': 'flight_name', 'matrix': None, 'screen_all': True, 'token_required': False}, {'ri': 'Argo', 'node': 'https://beacon-argo.maris.nl', 'table': 'argo', 'time': 'JULD', 'latitude': 'LATITUDE', 'longitude': 'LONGITUDE', 'height': 'PRES', 'height_is_text': False, 'site': 'PLATFORM_NUMBER', 'matrix': None, 'screen_all': False, 'token_required': True}, {'ri': 'CDI', 'node': 'https://beacon-cdi.maris.nl', 'table': 'default', 'time': 'TIME', 'latitude': 'LATITUDE', 'longitude': 'LONGITUDE', 'height': 'DEPTH', 'height_is_text': False, 'site': 'SDN_STATION', 'matrix': None, 'screen_all': False, 'token_required': True}]"
