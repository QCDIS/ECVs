                "name": "exv_code",
                "type": "str"
              },
              {
                "name": "file_exv",
                "type": "str"
              }
            ],
            "confs": [
              {
                "name": "conf_SERVICE_URL_NERC_VOCAB",
                "assignation": "conf_SERVICE_URL_NERC_VOCAB = 'http://vocab.nerc.ac.uk/collection'"
              },
              {
                "name": "conf_SERVICE_URL_NERC_SPARQL",
                "assignation": "conf_SERVICE_URL_NERC_SPARQL = 'https://vocab.nerc.ac.uk/sparql/sparql'"
              },
              {
                "name": "conf_label_spelling",
                "assignation": "conf_label_spelling = {'vapour': 'vapor', 'colour': 'color', 'sulphate': 'sulfate', 'sulphur': 'sulfur', 'aerosols': 'aerosol'}"
              },
              {
                "name": "conf_label_qualifiers",
                "assignation": "conf_label_qualifiers = ['surface', 'upper', 'subsurface', 'and', 'other', 'the', 'of', 'from', 'properties', 'budget', 'earth', 'ocean', 'anthropogenic', 'ad']"
              },
              {
                "name": "conf_iadopt_media",
                "assignation": "conf_iadopt_media = ['water body', 'air', 'atmosphere', 'sea water', 'water']"
              },
              {
                "name": "conf_exv_label_hints",
                "assignation": "conf_exv_label_hints = {'EXV008': [['wind', 'speed'], ['wind', 'direction'], ['eastward', 'wind'], ['northward', 'wind']], 'EXV031': [['cfc11'], ['cfc12'], ['cfc113'], ['sulfur', 'hexafluoride']], 'EXV034': [['phytoplankton'], ['zooplankton']], 'EXV038': [['river'], ['rivers']], 'EXV042': [['land', 'ice']], 'EXV043': [['ice', 'sheet'], ['ice', 'shelf']], 'EXV045': [['photosynthetic', 'absorbed']], 'EXV049': [['vegetation', 'carbon', 'content']], 'EXV053': [['anthropogenic', 'emission']], 'EXV055': [['irrigation']]}"
              },
              {
                "name": "conf_iadopt_matrix_words",
                "assignation": "conf_iadopt_matrix_words = {'water body': ['water']}"
              },
              {
                "name": "conf_cf_exclude",
                "assignation": "conf_cf_exclude = ['stagnation_air_temperature', 'platform_speed_wrt_air', 'platform_speed_wrt_ground', 'barometric_altitude', 'gps_altitude', 'altitude_wrt_radar', 'status_flag']"
              },
              {
                "name": "conf_minio_user_local_root",
                "assignation": "conf_minio_user_local_root = os.path.join(os.path.join('/', 'home', 'jovyan', 'Cloud Storage'), 'naa-vre-user-data', 'ECVs')"
              },
              {
                "name": "conf_vlab_name",
                "assignation": "conf_vlab_name = 'ECVs'"
              }
            ],
            "params": [],
            "secrets": [],
            "kernel": "ipython",
            "template_format": "v1"
          }
        },
